---
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import '../styles/global.css'

type Props = {
  title?: string
  description?: string
}

const {
  title = 'Shinri Maeshiro',
  description = 'Engineer',
} = Astro.props
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
    <meta property="og:site_name" content="Eden Creative Team" />
    <meta property="og:title" content="Eden Creative Team" />
    <meta
      property="og:description"
      content="作品や事業に宿る「熱狂」を社会に届けるクリエイティブチームです。"
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://eden-creative-team.pages.dev/" />
    <meta property="og:image" content="https://eden-creative-team.pages.dev/ogp.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Eden Creative Team" />
    <meta
      name="twitter:description"
      content="作品や事業に宿る「熱狂」を社会に届けるクリエイティブチームです。"
    />
    <meta name="twitter:image" content="https://eden-creative-team.pages.dev/ogp.png" />
  </head>
  <body>
    <div class="site-bg" aria-hidden="true">
      <span class="site-bg__cloud site-bg__cloud--1"></span>
      <span class="site-bg__cloud site-bg__cloud--2"></span>
      <span class="site-bg__cloud site-bg__cloud--3"></span>
      <span class="site-bg__cloud site-bg__cloud--4"></span>
      <span class="site-bg__cloud site-bg__cloud--5"></span>
    </div>
    <div class="site-shell">
      <Header />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
